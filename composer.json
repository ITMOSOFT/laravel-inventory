{
  "name": "itmosoft/laravel-inventory",
  "description": "A reusable Laravel inventory package for stock locations, stock levels, movements, and reservations.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.3", "illuminate/database": "^12.0 || ^13.0", "illuminate/support": "^12.0 || ^13.0"},
  "require-dev": {"orchestra/testbench": "^10.0 || ^11.0", "phpunit/phpunit": "^11.5"},
  "autoload": {"psr-4": {"ItmoSoft\\Inventory\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\Inventory\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\Inventory\\InventoryServiceProvider"]}},
  "scripts": {"test": "phpunit"},
  "config": {"sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}
